# RAC Crew — this directory stores server-side rate-limit and lead-backup
# data used internally by the PHP handlers. It must never be reachable
# directly by a browser request.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

Options -Indexes
